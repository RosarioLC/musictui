Screen {
    layout: grid;
    grid-size: 2;
    grid-columns: 1fr 1fr;
    grid-rows: auto 1fr auto;
    grid-gutter: 1;
    background: #121212;
    color: #f5f5f5;
    padding: 1 2;
    overflow-x: hidden;
    overflow-y: hidden;
}

#home-title,
#library-title,
#playlist-name {
    column-span: 2;
    width: 100%;
    height: 4;
    padding: 1 2;
    color: #ffffff;
    text-style: bold;
    content-align: left middle;
}

DataTable {
    width: 100%;
    height: 100%;
    background: #181818;
    border: solid #282828;
    color: #d9d9d9;
    padding: 0 1;
    scrollbar-size: 1 1;
    scrollbar-color: gray;
    scrollbar-background: black;
}

DataTable:focus {
    border: solid #1ed760;
}

DataTable > .datatable--header {
    color: #b3b3b3;
    background: #181818;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: #282828;
    color: #ffffff;
}

#search-bar {
    column-span: 2;
    width: 100%;
    height: 4;
    layout: horizontal;
    content-align: center middle;
}

#search-box {
    width: 70%;
    margin: 0;
    height: 3;
    border: round #535353;
    color: #ffffff;
    background: #242424;
    padding: 0 1;
}

#search-label {
    width: 8;
    height: 3;
    color: #1ed760;
    text-style: bold;
    content-align: right middle;
    padding: 0 1 0 0;
}

#search-box:focus {
    border: round #1ed760;
}

#search-results {
    column-span: 2;
    width: 1fr;
    height: 1fr;
}

#search-results #track-list-scroll {
    scrollbar-size: 1 1;
    scrollbar-color: #666666;
    scrollbar-color-hover: #666666;
    scrollbar-color-active: #666666;
    scrollbar-background: black;
}

.result-message {
    padding: 1 2;
    color: #a0a0a0;
}

#recommended {
    column-span: 2;
    width: 1fr;
}

#queue-panel {
    column-span: 2;
    height: 8;
    min-height: 8;
    background: #181818;
    border: solid #282828;
    padding: 1;
}

#queue-panel Label {
    height: 2;
    color: #b3b3b3;
    text-style: bold;
}

#queue-tracks {
    height: 4;
    border: none;
    padding: 0;
}

#now-playing {
    dock: bottom;
    width: 1fr;
    height: 13;
    background: #181818;
    border-top: solid #282828;
    padding: 1 2;
    layout: horizontal;
    margin-bottom: 1;
}

#track-info {
    width: 40;
    min-width: 40;
    height: 24;
    layout: horizontal;
    color: #ffffff;
}

#album-art {
    width: 24;
    min-width: 24;
    max-width: 24;
    height: 24;
    min-height: 24;
    max-height: 24;
    color: #1ed760;
    padding: 0;
}

#track-metadata {
    width: 14;
    height: 24;
    layout: vertical;
}

#track-title {
    height: 3;
    color: #ffffff;
    text-style: bold;
    padding: 1 0 0 1;
}

#track-artist {
    width: 14;
    height: 2;
    color: #b3b3b3;
    padding: 0 0 0 1;
}

#playback-center {
    width: 1fr;
    min-width: 30;
    layout: vertical;
    content-align: center middle;
    align-horizontal: center;
    align-vertical: middle;
}

#player-controls {
    width: auto;
    min-width: 27;
    height: 4;
    layout: horizontal;
    content-align: center middle;
}

.control-spacer {
    width: 1fr;
}

#progress-row {
    width: 100%;
    height: 4;
    layout: horizontal;
    content-align: center middle;
}

#current-time,
#duration-time {
    width: 6;
    min-width: 6;
    color: #b3b3b3;
    content-align: center middle;
}

#player-controls Button,
#player-utilities Button,
#volume-control Button {
    min-width: 7;
    width: 7;
    height: 4;
    margin: 0 1;
    background: transparent;
    color: #b3b3b3;
    border: none;
    text-style: bold;
}

#player-controls Button:hover,
#player-utilities Button:hover,
#volume-control Button:hover {
    color: #1ed760;
    background: #282828;
}

#player-controls #play-pause {
    color: #000000;
    background: #ffffff;
    text-style: bold;
}

#player-controls #play-pause:hover {
    color: #000000;
    background: #1ed760;
}

.track-progress {
    width: 1fr;
    height: 3;
    min-height: 3;
    margin: 1 2;
    color: #1ed760;
}

#player-utilities {
    width: 42;
    min-width: 42;
    layout: horizontal;
    content-align: center middle;
    align-vertical: middle;
}

#volume-control {
    width: 22;
    min-width: 22;
    height: 6;
    layout: horizontal;
    content-align: center middle;
}

#volume-control Slider {
    width: 14;
    min-width: 14;
    height: 3;
    color: #1ed760;
}

#player-utilities #fullscreen {
    color: #b3b3b3;
}

#player-utilities #lyrics {
    color: #1ed760;
}

#action-hints {
    dock: bottom;
    width: 1fr;
    height: 1;
    background: #000000;
    color: #6f6f6f;
    content-align: center middle;
    text-style: bold;
    margin: 0 0 19 0;
}

#next-track {
    dock: right;
    layer: above;
    width: 40;
    height: 10;
    margin: 0 2 12 0;
    padding: 0 1 0 1;
    background: #242424;
    border: solid #1ed760;
}

#next-label {
    height: 1;
    color: #1ed760;
    padding: 0 11 0 8;
    text-style: bold;
}

#next-text {
    layout: vertical;
    width: 24;
    height: 10;
    content-align: right top;
}

#next-art {
    width: 16;
    min-width: 16;
    height: 16;
    min-height: 16;
    max-height: 16;
    color: #1ed760;
}

#next-track-details {
    width: 100%;
    layout: horizontal;
    height: 10;
}

#next-metadata {
    width: 20;
    height: 10;
    content-align: center middle;
}

Footer {
    dock: bottom;
    height: 1;
    background: #000000;
    color: #b3b3b3;
    margin: 0;
}

Footer > .footer--key {
    background: #3b3b3b;
    color: #d0d0d0;
}

Footer > .footer--description {
    color: #a0a0a0;
}

Footer > .footer--highlight-key {
    background: #4a4a4a;
    color: #ffffff;
}

Screen.player-focused #queue-panel {
    display: none;
}

#lyrics-screen {
    layout: vertical;
    background: #121212;
    padding: 2 4;
    overflow: hidden hidden;
}

#lyrics-title {
    height: 3;
    color: #ffffff;
    text-style: bold;
}

#lyrics-list {
    height: 1fr;
    background: #181818;
    border: solid #282828;
    padding: 1 2;
    scrollbar-color: #666666;
    scrollbar-color-hover: #555555;
    scrollbar-background: #000000;
}


.lyrics-active {
    color: #1ed760;
    text-style: bold;
    background: transparent;
}

#lyrics-help {
    height: 2;
    color: #6f6f6f;
}

#fullscreen-screen {
    layout: vertical;
    background: #000000;
    align: center middle;
    padding: 1;
    overflow: hidden hidden;
}

#fullscreen-art {
    width: 1fr;
    height: 1fr;
    min-height: 1;
    content-align: center middle;
    color: #1ed760;
}

#fullscreen-caption {
    dock: bottom;
    width: 100%;
    height: 3;
    color: #ffffff;
    text-style: bold;
    content-align: center middle;
}


#library-content {
    layout: horizontal;
    height: 1fr;
    column-span: 2;
}

#playlists {
    width: 30;
    min-width: 30;
    max-width: 30;
}

#playlist-songs {
    width: 1fr;
    height: 1fr;
}

#playlist-songs #track-list-scroll {
    scrollbar-size: 1 1;
    scrollbar-color: #666666;
    scrollbar-color-hover: #666666;
    scrollbar-color-active: #666666;
    scrollbar-background: black;
}

#recommended #track-list-scroll {
    scrollbar-size: 1 1;
    scrollbar-color: #666666;
    scrollbar-color-hover: #666666;
    scrollbar-color-active: #666666;
    scrollbar-background: black;
}

#playlist-tracks {
    column-span: 2;
    width: 1fr;
    height: 1fr;
}

#playlist-tracks #track-list-scroll {
    scrollbar-size: 1 1;
    scrollbar-color: #666666;
    scrollbar-color-hover: #666666;
    scrollbar-color-active: #666666;
    scrollbar-background: black;
}

ListView {
    scrollbar-color: #535353;
    scrollbar-color-hover: #535353;
    scrollbar-color-active: #535353;
    scrollbar-background: #121212;
}

ListView:focus {
    scrollbar-color: #737373;
}


#dialog {
    background: #181818;
    border: solid #1ed760;
    width: 60;
    height: 14;
    padding: 1 4;
    layout: vertical;
    align: center middle;
}

#title {
    text-style: bold;
    color: #ffffff;
    height: 3;
    content-align: left middle;
}

#name-input {
    width: 100%;
    margin-top: 1;
    margin-bottom: 1;
    padding: 0 1;
    height: 3;
    color: #ffffff;
    background: #242424;
    border: round #535353;
}

#buttons {
    width: 100%;
    layout: horizontal;
}

#buttons Button {
    width: 50%;
}

TrackRow {
    height: 8;
    width: 100%;
    layout: horizontal;
    background: #181818;
}

TrackRow:hover {
    background: #282828;
}

TrackRow .track-art {
    width: 16;
    min-width: 16;
    max-width: 16;
    height: 8;
    min-height: 8;
    max-height: 8;
    content-align: center middle;
    padding: 0;
}

TrackRow .track-title {
    width: 30;
    min-width: 20;
    height: 2;
    color: #ffffff;
    text-style: bold;
    padding: 1 1 0 1;
    overflow: hidden;
}

TrackRow .track-artist {
    width: 20;
    min-width: 15;
    height: 2;
    color: #b3b3b3;
    padding: 1 1 0 1;
    overflow: hidden;
}

TrackRow .track-album {
    width: 25;
    min-width: 15;
    height: 2;
    color: #b3b3b3;
    padding: 1 1 0 1;
    overflow: hidden;
}

TrackRow .track-duration {
    width: 10;
    min-width: 8;
    height: 2;
    color: #b3b3b3;
    padding: 1 1 0 1;
}

.heart-button {
    width: 6;
    min-width: 6;
    max-width: 6;
    height: 8;
    min-height: 8;
    max-height: 8;
    background: transparent;
    color: #b3b3b3;
    padding: 0;
    content-align: center middle;
}

.heart-button.heart-liked {
    background: transparent;
    color: #1ed760;
}
